# ============================================
# Leantime 3.10.0 - .gitignore
# ============================================

# --- Laravel Environment ---
.env
.env.backup
.env.production
.env.testing
.env.local
config/.env
config/.env.backup
config/.env.production
config/.env.testing
config/.env.local
/storage/*.key
/auth.json
Homestead.json
Homestead.yaml

# --- Laravel Storage (Runtime Artifacts) ---
# این پوشه‌ها حاوی فایل‌های موقتی و کش هستند و نباید آپلود شوند
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/logs/*
/storage/pail

# --- Build & Cache Files ---
*.log
.phpunit.result.cache
.phpunit.cache
.php_cs.cache
.phpactor.json
.phpintel/
.phpactor.json
_ide_helper.php
routes.json
stan.txt

# --- IDE & Editor Files ---
.idea/
/.idea/
.vscode/
/.vscode/
.fleet/
/.fleet/
.nova/
/.nova/
.zed/
/.zed/
*.swp
*.swo
*~

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Composer (فقط فایل‌های موقتی) ---

composer.phar

# --- Node (فقط فایل‌های موقتی) ---
# node_modules/ عمداً ignore نشده است
npm-debug.log
yarn-debug.log
yarn-error.log

# --- Database & Docker ---
.docker/flarepoint-db/*

# Ignore specific font folders
public/dist/fonts/eot/
public/dist/fonts/ttf/
public/dist/fonts/woff/
public/dist/fonts/woff2/